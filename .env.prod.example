# -------------------------------------------------------------
# 腾讯云生产环境配置模板 (.env.prod)
# 使用前请重命名为 .env，并修改敏感密码
# -------------------------------------------------------------

# 1. 外部访问端口（默认使用 80 端口，可直接通过 http://公网IP 访问）
PROD_PORT=80

# 2. 数据库配置（生产环境请设置高强度独立密码）
POSTGRES_DB=class_schedule
POSTGRES_USER=class_schedule
POSTGRES_PASSWORD=replace_with_your_strong_db_password

# 3. 初始系统管理员引导账号
APP_AUTH_BOOTSTRAP_USERNAME=admin
APP_AUTH_BOOTSTRAP_PASSWORD=replace_with_your_strong_admin_password

# 4. 用户注册控制
APP_AUTH_REGISTRATION_ENABLED=false
APP_AUTH_REGISTRATION_DEFAULT_ROLE=PLANNER
APP_AUTH_EMAIL_CODE_SECRET=replace_with_a_random_email_code_secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=no-reply@example.com

# 5. AI 对话与智能排课助手配置（兼容 OpenAI 规范，如 DeepSeek）
APP_AI_BASE_URL=https://api.deepseek.com
APP_AI_API_KEY=replace_with_your_provider_key
APP_AI_MODEL=deepseek-chat
