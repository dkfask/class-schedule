POSTGRES_DB=class_schedule
POSTGRES_USER=class_schedule
POSTGRES_PASSWORD=class_schedule
DATABASE_URL=jdbc:postgresql://localhost:5432/class_schedule
DATABASE_USERNAME=class_schedule
DATABASE_PASSWORD=class_schedule
APP_AUTH_BOOTSTRAP_USERNAME=planner
APP_AUTH_BOOTSTRAP_PASSWORD=change-this-in-local-env
APP_AUTH_REGISTRATION_ENABLED=false
APP_AUTH_REGISTRATION_DEFAULT_ROLE=PLANNER
APP_AUTH_EMAIL_CODE_SECRET=change-this-email-code-secret
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=no-reply@class-schedule.local
APP_PDF_FONT_PATH=
APP_PDF_FONT_NAME=
# AI 辅助（对话式排课助手）：默认 OpenAI 兼容端点；也可在系统设置中选择 Anthropic 兼容
APP_AI_BASE_URL=
APP_AI_API_KEY=
APP_AI_MODEL=
# 管理员在系统内保存 API Key 时使用；生产环境请替换为稳定随机值
APP_AI_CONFIG_ENCRYPTION_KEY=
